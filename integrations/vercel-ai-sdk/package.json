{
  "name": "@botsrated/ai-sdk",
  "version": "0.1.3",
  "description": "Vercel AI SDK payment-client wrap for BotsRated: attachPaymentGuard before pay, plus optional free preflight tools. Not a generation runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "homepage": "https://botsrated.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botsrated/botsrated.git",
    "directory": "integrations/vercel-ai-sdk"
  },
  "dependencies": {
    "@botsrated/x402-preflight": "^0.3.0"
  },
  "peerDependencies": {
    "ai": ">=5",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "zod": "^4.1.8"
  },
  "bugs": {
    "url": "https://github.com/botsrated/botsrated/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
