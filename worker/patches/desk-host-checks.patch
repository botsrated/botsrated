+// Desk per-host outside Guard checks. No network. No D1 writes.
+import { readFileSync } from "node:fs";
+import assert from "node:assert/strict";
+import {
+  DESK_HOST_CHECKS_QA_CLEAN,
+  DESK_HOST_CHECKS_TTL_MS,
+  attachDeskHostChecks,
+  deskHostChecksBinds,
+  deskHostChecksHtml,
+  deskHostChecksNoteHtml,
+  deskHostChecksSql,
+  isoWeekUtc,
+  loadDeskHostChecks,
+  publishableOutsideGuardKeys,
+  resetDeskHostChecksMemo,
+  sumPublishableHostChecks,
+  type DeskHostChecksDb,
+} from "../src/desk_host_checks.ts";
+
+const TITLE = "Outside Guard checks for this host this ISO week (UTC). Our own tests excluded. A count, not a rating.";
+const FACT = (n: number) => `<span class="desk-host-checks" data-n="${n}" title="${TITLE}">Checked <b>${n}</b> times this week</span>`;
+const NOTE = `<p class="desk-host-checks-note">Outside Guard checks this week · <a href="/llms-install.md#how-we-count-outside-attaches">How we count</a> · A count, not a rating</p>`;
+
+assert.equal(DESK_HOST_CHECKS_TTL_MS, 15 * 60 * 1000);
+assert.ok(DESK_HOST_CHECKS_TTL_MS <= 15 * 60 * 1000);
+assert.equal(DESK_HOST_CHECKS_QA_CLEAN, false);
+assert.equal(isoWeekUtc(new Date(Date.UTC(2026, 10, 5, 4, 30))), "2026-W45");
+
+assert.equal(deskHostChecksHtml(4, true), FACT(4));
+assert.equal(deskHostChecksHtml(0, true), "");
+assert.equal(deskHostChecksHtml(null, true), "");
+assert.equal(deskHostChecksHtml(1.5, true), "");
+assert.equal(deskHostChecksHtml(-3, true), "");
+assert.equal(deskHostChecksHtml(4, false), "");
+assert.equal(deskHostChecksHtml(4), "");
+assert.equal(deskHostChecksHtml(4, true).includes("Checked 0"), false);
+
+const hidden = [{ host: "blockrun.ai", checks_week: 1 }];
+assert.equal(deskHostChecksNoteHtml(hidden, false), "");
+const shown = [{ host: "seller.example", checks_week: 4 }];
+assert.equal(deskHostChecksNoteHtml(shown, true), NOTE);
+assert.equal(deskHostChecksNoteHtml([{ host: "seller.example", checks_week: null }], true), "");
+
+const summed = sumPublishableHostChecks([
+  { k: "d626e00ddeadbeefdeadbeef", host: "blockrun.ai", channel: "guard", n: 1 },
+  { k: "aaaaaaaaaaaaaaaaaaaaaaaa", host: "seller.example", channel: "guard", n: 2 },
+  { k: "bbbbbbbbbbbbbbbbbbbbbbbb", host: "seller.example", channel: "guard", n: 3 },
+  { k: "cccccccccccccccccccccccc", host: "botsrated.com", channel: "guard", n: 9 },
+  { k: "dddddddddddddddddddddddd", host: "other.example", channel: "internal", n: 8 },
+  { k: "eeeeeeeeeeeeeeeeeeeeeeee", host: "site.example", channel: "site", n: 7 },
+  { k: "ffffffffffffffffffffffff", host: "zero.example", channel: "guard", n: 0 },
+]);
+assert.deepEqual(summed, [{ host: "seller.example", n: 5 }]);
+assert.equal(publishableOutsideGuardKeys(["outside-a", "d626e00d-smoke", "outside-b"]).length, 2);
+
+const sql = deskHostChecksSql();
+assert.equal(sql.includes("callers_week_host"), true);
+assert.equal(sql.includes("channel = 'guard'"), true);
+assert.equal(sql.includes("k NOT LIKE ?2"), true);
+assert.equal(sql.includes("host_stats"), false);
+assert.equal(sql.includes("internal"), false);
+assert.deepEqual(deskHostChecksBinds(new Date(Date.UTC(2026, 10, 5))), ["2026-W45", "d626e00d%", "botsrated.com", "www.botsrated.com", "botpulse.botsrated.com"]);
+
+let prepares = 0;
+const boundWeeks: string[] = [];
+const db: DeskHostChecksDb = {
+  prepare(seen: string) {
+    assert.equal(seen, sql);
+    prepares += 1;
+    return {
+      bind(...args: unknown[]) {
+        boundWeeks.push(String(args[0]));
+        assert.equal(args[1], "d626e00d%");
+        assert.deepEqual(args.slice(2), ["botsrated.com", "www.botsrated.com", "botpulse.botsrated.com"]);
+        return {
+          async all() {
+            return { results: [{ host: "Seller.Example", n: 5 }, { host: "botsrated.com", n: 4 }, { host: "zero.example", n: 0 }] };
+          },
+        };
+      },
+    };
+  },
+};
+resetDeskHostChecksMemo();
+const now = new Date(Date.UTC(2026, 10, 5, 1, 0));
+const first = await loadDeskHostChecks(db, now, 1_000);
+assert.deepEqual(first, [{ host: "seller.example", n: 5 }]);
+const second = await loadDeskHostChecks(db, now, 1_000 + DESK_HOST_CHECKS_TTL_MS - 1);
+assert.deepEqual(second, first);
+assert.equal(prepares, 1);
+const third = await loadDeskHostChecks(db, now, 1_000 + DESK_HOST_CHECKS_TTL_MS);
+assert.equal(prepares, 2);
+const nextWeek = await loadDeskHostChecks(db, new Date(Date.UTC(2026, 10, 12)), 1_000 + DESK_HOST_CHECKS_TTL_MS);
+assert.equal(prepares, 3);
+assert.deepEqual(boundWeeks, ["2026-W45", "2026-W45", "2026-W46"]);
+assert.equal(nextWeek[0].host, "seller.example");
+
+const nodes = [{ host: "seller.example" }, { host: "blockrun.ai" }];
+await attachDeskHostChecks(db, nodes, now, 1_000);
+assert.equal(nodes[0].checks_week, null);
+assert.equal(nodes[1].checks_week, null);
+assert.equal(deskHostChecksHtml(nodes[0].checks_week), "");
+
+const desk = readFileSync("src/desk.ts", "utf8");
+const site = readFileSync("src/site.ts", "utf8");
+assert.equal(desk.includes("${deskChipsHtml(x)}${deskHostChecksHtml(x.checks_week)}"), true);
+assert.equal(desk.includes("</table></div>${deskHostChecksNoteHtml(r.nodes)}${deskSkippedHtml"), true);
+assert.equal(desk.includes("export async function deskPreviewStampHostChecks"), true);
+assert.equal(desk.includes("await attachDeskHostChecks(db, nodes)"), true);
+assert.equal(desk.includes('${deskMapNextHtml(r, esc)}${outsideCallersChipHtml()}${deskGuardHtml(source)}'), true);
+assert.equal(desk.split("${outsideCallersChipHtml()}").length - 1, 1);
+const freeAt = desk.indexOf("deskFreeHtml");
+const freeBody = freeAt < 0 ? "" : desk.slice(freeAt, freeAt + 700);
+assert.equal(freeBody.includes("deskHostChecks"), false);
+assert.equal(freeBody.includes("desk-host-checks"), false);
+for (const rule of [
+  ".desk-host-checks{display:inline-block;margin:4px 0 0;font-size:13px;line-height:1.4;color:var(--bw-muted)}",
+  ".desk-host-checks b{color:var(--bw-fg);font-weight:600}",
+  '.desk-host-checks[data-n="0"],.desk-host-checks:not([data-n]){display:none}',
+  ".desk-host-checks-note{margin:8px 0 0;font-size:13px;line-height:1.4;color:var(--bw-muted)}",
+  ".desk-host-checks-note a{color:var(--bw-fg);text-decoration:none;border-bottom:1px solid var(--bw-line)}",
+  ".desk-host-checks-note a:hover{border-bottom-color:var(--bw-fg)}",
+]) {
+  assert.equal(site.includes(rule), true, rule);
+}
+assert.equal(site.includes("export function outsideCallersChipHtml"), true);
+const mod = readFileSync("src/desk_host_checks.ts", "utf8");
+assert.equal(mod.includes('from "./outside_count'), false);
+assert.equal(mod.includes("from './outside_count"), false);
+assert.equal(mod.includes("process.exit"), false);
+console.log("desk_host_checks_unit ok");
