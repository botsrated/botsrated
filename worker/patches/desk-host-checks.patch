--- a/worker/src/desk_host_checks.ts
+++ b/worker/src/desk_host_checks.ts
@@ -0,0 +1,135 @@
+// Desk per-host outside Guard checks. Design LOCK body ba26a862.
+// Read path only. D1 Tip-B writes stay live-on-check; this module does not write and does not cache writes.
+// Edge memo for the Desk SUM read refreshes every 15 minutes (TTL <= 15m). Not a page cache.
+// Smoke-exclude LIVE leave-off 2e7581cb. This module does not import outside_count; that import keeps exit 53.
+
+export const DESK_HOST_CHECKS_TTL_MS = 15 * 60 * 1000;
+
+/** Guard-persisted smoke caller key prefix. Never an outside caller. */
+export const GUARD_SMOKE_K_PREFIXES = ["d626e00d"] as const;
+
+/** Public site aliases. DC own-host re-check. A third-party host checked only by a smoke key is not added here. */
+export const DESK_OWN_HOSTS = [
+  "botsrated.com",
+  "www.botsrated.com",
+  "botpulse.botsrated.com",
+] as const;
+
+/** DC owner-set. False until DC CLEAR on non-empty guard host rows after smoke-k exclusion. */
+export const DESK_HOST_CHECKS_QA_CLEAN = false;
+
+export const DESK_HOST_CHECKS_TITLE =
+  "Outside Guard checks for this host this ISO week (UTC). Our own tests excluded. A count, not a rating.";
+
+export interface DeskHostNode {
+  host?: string;
+  checks_week?: number | null;
+}
+
+export interface DeskHostChecksDb {
+  prepare(sql: string): {
+    bind(...values: unknown[]): {
+      all(): Promise<{ results?: { host: string; n: number }[] }>;
+    };
+  };
+}
+
+export interface CallerHostRow {
+  k: string;
+  host: string;
+  channel: string;
+  n: number;
+}
+
+type Memo = { at: number; week: string; rows: { host: string; n: number }[] };
+
+let memo: Memo | null = null;
+
+export function resetDeskHostChecksMemo(): void {
+  memo = null;
+}
+
+export function isoWeekUtc(now: Date = new Date()): string {
+  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
+  const day = d.getUTCDay() || 7;
+  d.setUTCDate(d.getUTCDate() + 4 - day);
+  const isoYear = d.getUTCFullYear();
+  const week = Math.ceil((((d.getTime() - Date.UTC(isoYear, 0, 1)) / 86400000) + 1) / 7);
+  return `${isoYear}-W${String(week).padStart(2, "0")}`;
+}
+
+export function isSmokeCallerKey(k: string): boolean {
+  const key = String(k || "");
+  return GUARD_SMOKE_K_PREFIXES.some((prefix) => key === prefix || key.startsWith(prefix));
+}
+
+export function isOwnDeskHost(host: string): boolean {
+  return (DESK_OWN_HOSTS as readonly string[]).includes(String(host || "").toLowerCase());
+}
+
+export function publishableOutsideGuardKeys(keys: readonly string[]): string[] {
+  return keys.filter((k) => !isSmokeCallerKey(k));
+}
+
+/** Pure SUM(n) for channel guard. Drops smoke keys, own hosts, and n that is not an integer > 0. */
+export function sumPublishableHostChecks(rows: readonly CallerHostRow[]): { host: string; n: number }[] {
+  const sums = new Map<string, number>();
+  for (const row of rows) {
+    if (!row || row.channel !== "guard") continue;
+    if (isSmokeCallerKey(String(row.k || ""))) continue;
+    if (isOwnDeskHost(String(row.host || ""))) continue;
+    if (typeof row.n !== "number" || !Number.isInteger(row.n) || row.n <= 0) continue;
+    const host = String(row.host).toLowerCase();
+    sums.set(host, (sums.get(host) || 0) + row.n);
+  }
+  return [...sums.entries()].map(([host, n]) => ({ host, n }));
+}
+
+export function deskHostChecksSql(prefixCount = GUARD_SMOKE_K_PREFIXES.length, ownCount = DESK_OWN_HOSTS.length): string {
+  const likes = Array.from({ length: prefixCount }, (_, i) => `k NOT LIKE ?${i + 2}`).join(" AND ");
+  const owns = Array.from({ length: ownCount }, (_, i) => `?${prefixCount + 2 + i}`).join(", ");
+  return `SELECT host, SUM(n) AS n FROM callers_week_host WHERE week = ?1 AND channel = 'guard' AND ${likes} AND lower(host) NOT IN (${owns}) GROUP BY host`;
+}
+
+export function deskHostChecksBinds(now: Date = new Date()): unknown[] {
+  return [isoWeekUtc(now), ...GUARD_SMOKE_K_PREFIXES.map((prefix) => `${prefix}%`), ...DESK_OWN_HOSTS.map((host) => host.toLowerCase())];
+}
+
+export async function loadDeskHostChecks(db: DeskHostChecksDb, now: Date = new Date(), clock: number = Date.now()): Promise<{ host: string; n: number }[]> {
+  const week = isoWeekUtc(now);
+  if (memo && memo.week === week && clock >= memo.at && clock - memo.at < DESK_HOST_CHECKS_TTL_MS) return memo.rows;
+  const sql = deskHostChecksSql();
+  const out = await db.prepare(sql).bind(...deskHostChecksBinds(now)).all();
+  const rows = (out.results || []).filter((row) => row && !isOwnDeskHost(row.host) && typeof row.n === "number" && Number.isInteger(row.n) && row.n > 0).map((row) => ({ host: String(row.host).toLowerCase(), n: row.n }));
+  memo = { at: clock, week, rows };
+  return rows;
+}
+
+export function stampDeskHostChecks(nodes: DeskHostNode[] | null | undefined, rows: readonly { host: string; n: number }[], qaClean: boolean = DESK_HOST_CHECKS_QA_CLEAN): void {
+  const by = new Map<string, number>();
+  for (const row of rows || []) {
+    if (!row || isOwnDeskHost(row.host)) continue;
+    if (typeof row.n !== "number" || !Number.isInteger(row.n) || row.n <= 0) continue;
+    by.set(String(row.host).toLowerCase(), row.n);
+  }
+  for (const node of nodes || []) {
+    const n = by.get(String(node.host || "").toLowerCase());
+    node.checks_week = qaClean === true && typeof n === "number" && Number.isInteger(n) && n > 0 ? n : null;
+  }
+}
+
+export async function attachDeskHostChecks(db: DeskHostChecksDb, nodes: DeskHostNode[] | null | undefined, now: Date = new Date(), clock: number = Date.now()): Promise<void> {
+  const rows = await loadDeskHostChecks(db, now, clock);
+  stampDeskHostChecks(nodes, rows);
+}
+
+export function deskHostChecksHtml(n: unknown, qaClean: boolean = DESK_HOST_CHECKS_QA_CLEAN): string {
+  if (qaClean !== true || typeof n !== "number" || !Number.isInteger(n) || n <= 0) return "";
+  return `<span class="desk-host-checks" data-n="${n}" title="${DESK_HOST_CHECKS_TITLE}">Checked <b>${n}</b> times this week</span>`;
+}
+
+export function deskHostChecksNoteHtml(nodes: DeskHostNode[] | null | undefined, qaClean: boolean = DESK_HOST_CHECKS_QA_CLEAN): string {
+  const show = (nodes || []).some((node) => deskHostChecksHtml(node.checks_week, qaClean) !== "");
+  if (!show) return "";
+  return `<p class="desk-host-checks-note">Outside Guard checks this week · <a href="/llms-install.md#how-we-count-outside-attaches">How we count</a> · A count, not a rating</p>`;
+}
