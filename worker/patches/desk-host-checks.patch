+// Desk per-host outside Guard checks. No network. No D1 writes. No reader SQL in this file.
+import { readFileSync } from "node:fs";
+import assert from "node:assert/strict";
+import {
+  DESK_HOST_CHECKS_QA_CLEAN,
+  DESK_HOST_CHECKS_TTL_MS,
+  attachDeskHostChecks,
+  deskHostChecksHtml,
+  deskHostChecksNoteHtml,
+  isoWeekUtc,
+  resetDeskHostChecksMemo,
+  stampDeskHostChecks,
+  type HostChecksRow,
+} from "../src/desk_host_checks.ts";
+
+const TITLE = "Outside Guard checks for this host this ISO week (UTC). Our own tests excluded. A count, not a rating.";
+const FACT = (n: number) => `<span class="desk-host-checks" data-n="${n}" title="${TITLE}">Checked <b>${n}</b> times this week</span>`;
+const NOTE = `<p class="desk-host-checks-note">Outside Guard checks this week · <a href="/llms-install.md#how-we-count-outside-attaches">How we count</a> · A count, not a rating</p>`;
+
+assert.equal(DESK_HOST_CHECKS_TTL_MS, 15 * 60 * 1000);
+assert.ok(DESK_HOST_CHECKS_TTL_MS <= 15 * 60 * 1000);
+assert.equal(DESK_HOST_CHECKS_QA_CLEAN, false);
+assert.equal(isoWeekUtc(new Date(Date.UTC(2026, 10, 5, 4, 30))), "2026-W45");
+
+assert.equal(deskHostChecksHtml(4, true), FACT(4));
+assert.equal(deskHostChecksHtml(0, true), "");
+assert.equal(deskHostChecksHtml(null, true), "");
+assert.equal(deskHostChecksHtml(1.5, true), "");
+assert.equal(deskHostChecksHtml(4, false), "");
+assert.equal(deskHostChecksHtml(4), "");
+assert.equal(deskHostChecksNoteHtml([{ host: "seller.example", checks_week: 4 }], true), NOTE);
+assert.equal(deskHostChecksNoteHtml([{ host: "seller.example", checks_week: null }], true), "");
+
+const rows: HostChecksRow[] = [
+  { host: "Seller.Example", checks: 5 },
+  { host: "botsrated.com", checks: 4 },
+  { host: "www.botsrated.com", checks: 2 },
+  { host: "botpulse.botsrated.com", checks: 2 },
+  { host: "zero.example", checks: 0 },
+];
+const nodes = [{ host: "seller.example" }, { host: "botsrated.com" }, { host: "zero.example" }];
+stampDeskHostChecks(nodes, rows, true);
+assert.equal(nodes[0].checks_week, 5);
+assert.equal(nodes[1].checks_week, null);
+assert.equal(nodes[2].checks_week, null);
+stampDeskHostChecks(nodes, rows, false);
+assert.equal(nodes[0].checks_week, null);
+
+let reads = 0;
+const seenWeeks: string[] = [];
+resetDeskHostChecksMemo();
+const read = async (week: string) => {
+  reads += 1;
+  seenWeeks.push(week);
+  return rows;
+};
+const now = new Date(Date.UTC(2026, 10, 5, 1, 0));
+const live = [{ host: "seller.example" }];
+await attachDeskHostChecks(live, read, now, 1_000);
+assert.equal(live[0].checks_week, null);
+assert.equal(reads, 1);
+await attachDeskHostChecks(live, read, now, 1_000 + DESK_HOST_CHECKS_TTL_MS - 1);
+assert.equal(reads, 1);
+await attachDeskHostChecks(live, read, now, 1_000 + DESK_HOST_CHECKS_TTL_MS);
+assert.equal(reads, 2);
+await attachDeskHostChecks(live, read, new Date(Date.UTC(2026, 10, 12)), 1_000 + DESK_HOST_CHECKS_TTL_MS);
+assert.equal(reads, 3);
+assert.deepEqual(seenWeeks, ["2026-W45", "2026-W45", "2026-W46"]);
+
+const mod = readFileSync("src/desk_host_checks.ts", "utf8");
+const smokeLit = ["d626", "e00d"].join("");
+assert.equal(mod.includes(smokeLit), false);
+assert.equal(mod.includes("prepare("), false);
+assert.equal(mod.includes("outside_count"), true);
+assert.equal(mod.includes('from "./outside_count"'), false);
+
+const desk = readFileSync("src/desk.ts", "utf8");
+const site = readFileSync("src/site.ts", "utf8");
+assert.equal(desk.includes(smokeLit), false);
+assert.equal(desk.includes("${deskChipsHtml(x)}${deskHostChecksHtml(x.checks_week)}"), true);
+assert.equal(desk.includes("</table></div>${deskHostChecksNoteHtml(r.nodes)}${deskSkippedHtml"), true);
+assert.equal(desk.includes("export async function deskPreviewStampHostChecks"), true);
+assert.equal(desk.includes("outsideGuardHostChecksSql(week)"), true);
+assert.equal(desk.includes("outsideGuardHostChecks("), true);
+assert.equal((desk.match(/from "\.\/outside_count"/g) || []).length, 1);
+assert.equal(desk.includes('${deskMapNextHtml(r, esc)}${outsideCallersChipHtml()}${deskGuardHtml(source)}'), true);
+assert.equal(desk.split("${outsideCallersChipHtml()}").length - 1, 1);
+const freeAt = desk.indexOf("deskFreeHtml");
+const freeBody = freeAt < 0 ? "" : desk.slice(freeAt, freeAt + 700);
+assert.equal(freeBody.includes("deskHostChecks"), false);
+for (const rule of [
+  ".desk-host-checks{display:inline-block;margin:4px 0 0;font-size:13px;line-height:1.4;color:var(--bw-muted)}",
+  ".desk-host-checks b{color:var(--bw-fg);font-weight:600}",
+  '.desk-host-checks[data-n="0"],.desk-host-checks:not([data-n]){display:none}',
+  ".desk-host-checks-note{margin:8px 0 0;font-size:13px;line-height:1.4;color:var(--bw-muted)}",
+  ".desk-host-checks-note a{color:var(--bw-fg);text-decoration:none;border-bottom:1px solid var(--bw-line)}",
+  ".desk-host-checks-note a:hover{border-bottom-color:var(--bw-fg)}",
+]) {
+  assert.equal(site.includes(rule), true, rule);
+}
+assert.equal(site.includes("export function outsideCallersChipHtml"), true);
+console.log("desk_host_checks_unit ok");
