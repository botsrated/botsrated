+const SHOULD_BARE = ["free under $10 at risk", "paid verdict routes", "badge $1 / 30 days"];
+
+function judgmentClass(html: string, index: number, word: string): string {
+  const window = html.slice(Math.max(0, index - 90), Math.min(html.length, index + word.length + 90));
+  if (window.includes("Not a rating, ranking, or review.")) return "lock";
+  const around = html.slice(Math.max(0, index - 16), index + word.length + 16);
+  if (around.includes("x402-trust")) return "proper";
+  const before = html.slice(0, index);
+  const inQuote = (before.match(/&quot;/g) || []).length % 2 === 1 || (before.match(/`/g) || []).length % 2 === 1;
+  const after = html.slice(index, index + 180);
+  const attributed = /\(their term\)|\(their product names\)|\(their route name\)|\(their output values\)/.test(after);
+  if (inQuote && attributed) return "quoted";
+  if (SHOULD_BARE.some((phrase) => window.includes(phrase))) return "should-bare";
+  return "other";
+}
 
