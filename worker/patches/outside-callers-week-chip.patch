+// Owner-set published figure. Distinct outside Guard callers this ISO week (UTC).
+// metric outside_guard_callers_week. Week 2026-W45. as_of 2026-11-05T00:14:00Z.
+// callers_week, channel guard, internal excluded. Not a per-seller or per-host count.
+// qa_clean is the Data Checker flag. Render the chip and the home tease only when the gate passes.
+export const OUTSIDE_GUARD_CALLERS_WEEK: {
+  metric: "outside_guard_callers_week";
+  week: string;
+  n: number;
+  qa_clean: boolean;
+  as_of: string;
+} = {
+  metric: "outside_guard_callers_week",
+  week: "2026-W45",
+  n: 2,
+  qa_clean: true,
+  as_of: "2026-11-05T00:14:00Z",
+};
+
+export function outsideGuardCallersWeekN(row: { n: number | null; qa_clean: boolean } = OUTSIDE_GUARD_CALLERS_WEEK): number | null {
+  const n = row.n;
+  if (row.qa_clean === true && Number.isInteger(n) && n > 0) return n;
+  return null;
+}
+
+export function outsideCallersChipHtml(): string {
+  const n = outsideGuardCallersWeekN();
+  if (n == null) return "";
+  return `<p class="bw-checked-chip" data-n="${n}" title="Distinct outside networks that ran a free Guard check this ISO week (UTC). Our own tests excluded. A count, not a rating.">Guard checks this week: <b>${n}</b> outside callers · <a href="/llms-install.md#how-we-count-outside-attaches">How we count</a></p>`;
+}
+
+export function outsideCallersTeaseHtml(): string {
+  const n = outsideGuardCallersWeekN();
+  if (n == null) return "";
+  return `<p class="bw-checked-tease" data-n="${n}"><a href="/desk">See which sellers are being checked out the most → here</a></p>`;
+}
