+export const MARKET_FACTS_HOLD_CHANGES: readonly MarketChange[] = [];
+
+export function esc(s: string): string {
+  return String(s).replace(/[&<>"']/g, (c) => {
+    if (c === "&") return "&amp;";
+    if (c === "<") return "&lt;";
+    if (c === ">") return "&gt;";
+    if (c === '"') return "&quot;";
+    return "&#39;";
+  });
+}
+
+export function sourceHost(url: string): string {
+  try {
+    return new URL(url).hostname.replace(/^www\./, "");
+  } catch {
+    return "";
+  }
+}
+
+export function visibleMarketRows(rows: readonly MarketFactRow[]): MarketFactRow[] {
+  return rows
+    .filter((row) => row.as_of.trim() !== "" && sourceHost(row.source_url) !== "")
+    .slice()
+    .sort((a, b) => {
+      const aa = a.name.toLowerCase();
+      const bb = b.name.toLowerCase();
+      if (aa < bb) return -1;
+      if (aa > bb) return 1;
+      return 0;
+    });
+}
+
+const FOOTER_NEEDLE = '<li><a href="/leaderboard">Recent checks</a></li>';
+const FOOTER_LINK = '<li><a href="/market">Market facts</a></li>';
+const DOCS_NEEDLE = '<li><a href="/leaderboard">/leaderboard</a>: 300 x402 sellers, by recency of our checks.</li>';
+const DOCS_LINK = '<li><a href="/market">Market facts — published claims across the x402 and MCP space, with dates and sources</a></li>';
+
+/** Evidence column + /docs reference list. Idempotent. Other links stay put. */
+export function decorateSiteHtml(html: string): string {
+  let out = html;
+  if (out.includes(FOOTER_NEEDLE) && !out.includes(FOOTER_NEEDLE + FOOTER_LINK)) {
+    out = out.replace(FOOTER_NEEDLE, FOOTER_NEEDLE + FOOTER_LINK);
+  }
+  if (out.includes(DOCS_NEEDLE) && !out.includes(DOCS_NEEDLE + DOCS_LINK)) {
+    out = out.replace(DOCS_NEEDLE, DOCS_NEEDLE + DOCS_LINK);
+  }
+  return out;
+}
+
+function mono(text: string, title?: string): string {
+  const t = title ? ` title="${esc(title)}"` : "";
+  return `<span class="mf-mono"${t}>${esc(text)}</span>`;
+}
+
+function dateCell(isoDate: string, isoTitle: string | undefined, empty: string, emptyTitle?: string): string {
+  if (!isoDate) {
+    if (emptyTitle) return `<span class="mf-mono" title="${esc(emptyTitle)}">${esc(empty)}</span>`;
+    return esc(empty);
+  }
+  return mono(isoDate, isoTitle || `${isoDate}T00:00:00Z`);
+}
+
+function changedMark(at: string, now: Date): string {
+  const event = Date.parse(`${at}T00:00:00Z`);
+  const fresh = Number.isFinite(event) && now.getTime() - event < 7 * 86400000 && now.getTime() >= event;
+  const cls = fresh ? "mf-mark" : "mf-mark mf-mark-old";
+  return `<span class="${cls}">Changed</span>`;
+}
+
+function sourceLink(url: string, unreachable: boolean, asOfIso: string): string {
+  const host = sourceHost(url);
+  const link = `<a href="${esc(url)}" rel="nofollow noopener">${mono(host)}</a>`;
+  if (!unreachable) return link;
+  const day = asOfIso.slice(0, 10);
+  return `${link} <span class="mf-muted">Source unreachable as of ${esc(day)}</span>`;
+}
+
+function chipsHtml(row: MarketFactRow, courthouseLive: boolean): string {
+  if (!row.receipt_backed) return "";
+  const chips = (row.measured_chips || []).filter((chip) => chip.trim() !== "");
+  if (!chips.length) return "";
+  const pills = chips.map((chip) => `<span class="mf-chip">${esc(chip)}</span>`).join("");
+  const receipt = courthouseLive ? `<a href="/courthouse">Open signed receipt</a>` : "";
+  return `<p class="mf-measured">${pills}${receipt ? " " + receipt : ""}</p>`;
+}
+
+function rowCells(row: MarketFactRow, courthouseLive: boolean): string[] {
+  const ops = row.ops === "unreachable" ? ` <span class="mf-ops">unreachable</span>` : "";
+  const measured = chipsHtml(row, courthouseLive);
+  const prov = measured ? "" : ` <span class="mf-prov">Published</span>`;
+  const service = `<span class="mf-name">${esc(row.name)}</span>${ops}${prov} <a class="mf-upd" href="/disputes">Request update</a>${measured}`;
+  return [
+    service,
+    esc(row.offers),
+    esc(row.rails),
+    mono(row.price_as_published),
+    dateCell(row.as_of, row.as_of_iso, NO_DATA_CELL),
+    dateCell(row.first_seen, row.first_seen ? `${row.first_seen}T00:00:00Z` : undefined, NO_DATA_CELL),
+    dateCell(row.last_changed, row.last_changed_iso, NO_CHANGE, NO_CHANGE_TITLE),
+    sourceLink(row.source_url, false, row.as_of_iso),
+  ];
+}
+
+const HEADERS = [
+  "Service",
+  "Offers (as published)",
+  "Rails",
+  "Price (as published)",
+  "as of",
+  "First seen",
+  "Changed",
+  "Source",
+];
+
+function tableHtml(rows: readonly MarketFactRow[], courthouseLive: boolean): string {
+  const head = HEADERS.map((h) => `<th scope="col">${esc(h)}</th>`).join("");
+  const body = rows
+    .map((row) => `<tr>${rowCells(row, courthouseLive).map((cell) => `<td>${cell}</td>`).join("")}</tr>`)
+    .join("");
+  return `<table class="mf-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
+}
+
+function cardsHtml(rows: readonly MarketFactRow[], courthouseLive: boolean): string {
+  return rows
+    .map((row) => {
+      const cells = rowCells(row, courthouseLive);
+      const rest = HEADERS.slice(1)
+        .map((label, i) => `<div class="mf-kv"><span>${esc(label)}</span><span>${cells[i + 1]}</span></div>`)
+        .join("");
+      return `<article class="mf-card"><h3>${cells[0]}</h3>${rest}</article>`;
+    })
+    .join("");
+}
+
+function changeLine(event: MarketChange, now: Date): string {
+  const host = sourceHost(event.source_url);
+  if (!event.at || !host) return "";
+  const source = `<a href="${esc(event.source_url)}" rel="nofollow noopener">${mono(host)}</a>`;
+  const mark = changedMark(event.at, now);
+  const when = mono(event.at, event.at_iso || `${event.at}T00:00:00Z`);
+  if (event.kind === "First seen") {
+    return `<li>${mark} ${when} · ${esc(event.name)} · First seen · ${source}</li>`;
+  }
+  const from = event.from ?? "";
+  const to = event.to ?? "";
+  return `<li>${mark} ${when} · ${esc(event.name)} · ${esc(event.kind)} · ${esc(from)} → ${esc(to)} · ${source}</li>`;
+}
+
+export function renderMarketChanges(changes: readonly MarketChange[], now = new Date()): string {
+  const lines = changes
+    .slice()
+    .sort((a, b) => (a.at < b.at ? 1 : a.at > b.at ? -1 : 0))
+    .slice(0, 20)
+    .map((event) => changeLine(event, now))
+    .filter((line) => line !== "");
+  if (!lines.length) return `<p class="mf-empty">No changes yet.</p>`;
+  return `<ul class="mf-changes">${lines.join("")}</ul>`;
+}
+
+export function renderMarketFactsBody(opts?: {
+  publishRows?: boolean;
+  rows?: readonly MarketFactRow[];
+  changes?: readonly MarketChange[];
+  courthouseLive?: boolean;
+  now?: Date;
+}): string {
+  const publish = opts?.publishRows ?? MARKET_FACTS_PUBLISH_ROWS;
+  const rows = publish ? visibleMarketRows(opts?.rows ?? MARKET_FACTS_HOLD_ROWS) : [];
+  const changes = opts?.changes ?? MARKET_FACTS_HOLD_CHANGES;
+  const courthouseLive = opts?.courthouseLive === true;
+  const now = opts?.now ?? new Date();
+  const side = rows.length
+    ? `${tableHtml(rows, courthouseLive)}<div class="mf-cards">${cardsHtml(rows, courthouseLive)}</div>`
+    : `<p class="mf-empty">No data yet.</p>`;
+  return `<style>${MARKET_CSS}</style><div class="pg mf"><h1>Market facts</h1><p class="lede">${esc(MARKET_LEAD)}</p><p class="small mf-note">${esc(MARKET_NOTE)}</p><h2>Side by side</h2>${side}<h2>What changed</h2>${renderMarketChanges(changes, now)}<div class="mf-notes"><p>Peer entries are their published claims, quoted with a date and a source link. We do not probe or monitor them unless a row says Measured.</p><p>Changes are what we recorded from public sources when we last looked (as of the date shown), not continuous monitoring.</p><p>Something wrong or out of date? <a href="/disputes">Request an update</a></p><p><a href="/methodology">How we measure our own rows</a></p><p class="mf-muted"><a href="/docs">How Desk alerts work</a></p></div></div>`;
+}
+
+function ensureHead(doc: string): string {
+  let out = doc;
+  if (!out.includes('rel="canonical"')) {
+    out = out.replace("</head>", `<link rel="canonical" href="${MARKET_CANONICAL}"></head>`);
+  } else if (!out.includes(`href="${MARKET_CANONICAL}"`)) {
+    out = out.replace(/<link rel="canonical" href="[^"]*">/, `<link rel="canonical" href="${MARKET_CANONICAL}">`);
+  }
+  if (!out.includes('property="og:url"')) {
+    out = out.replace("</head>", `<meta property="og:url" content="${MARKET_CANONICAL}"></head>`);
+  }
+  if (!out.includes('property="og:title"')) {
+    out = out.replace("</head>", `<meta property="og:title" content="${esc(MARKET_TITLE)}"></head>`);
+  }
+  if (!out.includes('property="og:description"')) {
+    out = out.replace("</head>", `<meta property="og:description" content="${esc(MARKET_DESC)}"></head>`);
+  }
+  return out;
+}
+
+export function marketFactsDispatch(url: URL, request: Request, c: unknown, deps: MarketDeps): Response | null {
+  const path = url.pathname;
+  if (path !== MARKET_PATH && path !== `${MARKET_PATH}/`) return null;
+  if (request.method !== "GET" && request.method !== "HEAD") return null;
+  if (path === `${MARKET_PATH}/`) {
+    return new Response(null, { status: 301, headers: { Location: MARKET_PATH } });
+  }
+  const body = renderMarketFactsBody({
+    publishRows: MARKET_FACTS_PUBLISH_ROWS,
+    courthouseLive: deps.courthouseLive === true,
+    now: deps.now,
+  });
+  const doc = decorateSiteHtml(ensureHead(deps.shell(c, {
+    title: MARKET_TITLE,
+    desc: MARKET_DESC,
+    path: MARKET_PATH,
+    body,
+    script: false,
+  })));
+  return deps.html(c, doc, 200);
+}
+
+const MARKET_CSS = `
+.mf h1{letter-spacing:-0.02em;font-family:var(--bw-font)}
+.mf .lede{max-width:68ch}
+.mf-note,.mf-notes,.mf-muted,.mf-ops,.mf-prov,.mf-upd{color:var(--bw-muted)}
+.mf-notes{margin-top:28px}
