+.mf-mono{font-family:var(--bw-mono)}
+.mf a{color:var(--bw-fg)}
+.mf a:hover{color:var(--bw-muted)}
+.mf-table{width:100%;border-collapse:collapse;font-family:var(--bw-font)}
+.mf-table th,.mf-table td{border-bottom:1px solid var(--bw-line);text-align:left;vertical-align:top;padding:10px 8px;font-weight:400}
+.mf-table th{color:var(--bw-muted);font-weight:400}
+.mf-card{background:var(--bw-bg-2);border:1px solid var(--bw-line);border-radius:12px;padding:16px;margin:0 0 12px}
+.mf-card h3{margin:0 0 10px;font-size:1.05rem;font-weight:500}
+.mf-kv{display:grid;grid-template-columns:minmax(9rem,34%) 1fr;gap:8px;padding:6px 0;border-top:1px solid var(--bw-line)}
+.mf-kv span:first-child{color:var(--bw-muted)}
+.mf-prov,.mf-ops{font-size:.85rem;margin-left:6px}
+.mf-upd{font-size:.85rem;margin-left:8px}
+.mf-chip{display:inline-block;color:var(--bw-fg);border:1px solid var(--bw-line);border-radius:8px;padding:2px 8px;margin:0 4px 0 0}
+.mf-changes{list-style:none;padding:0;margin:0}
+.mf-changes li{border-top:1px solid var(--bw-line);padding:8px 0}
+.mf-mark{color:var(--bw-fg)}
+.mf-mark-old{color:var(--bw-muted)}
+.mf-empty{color:var(--bw-muted)}
+@media (max-width:899px){.mf-table{display:none}}
+@media (min-width:900px){.mf-cards{display:none}}
+`;

